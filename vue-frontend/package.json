{
  "name": "vue-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "build:check": "vue-tsc -b && vite build --configLoader runner",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:css": "stylelint 'src/**/*.{vue,css}'",
    "lint:css:fix": "stylelint 'src/**/*.{vue,css}' --fix",
    "lint:ui": "node scripts/check-ui-architecture.mjs",
    "lint:ui:audit": "node scripts/check-ui-architecture.mjs --audit",
    "format": "prettier --write src/",
    "visual:baseline": "playwright test --update-snapshots",
    "visual:test": "playwright test"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "jspdf": "^2.5.1",
    "jszip": "^3.7.1",
    "marked": "^17.0.1",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "fast-check": "^3.22.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.7.4",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.4"
  }
}
